# api mode: "mock" (in-browser fake API) or "live" (real backend)
VITE_API_MODE=live
# Absolute API origin for native (Capacitor) builds, e.g. https://lvs.example.app . Leave empty on the web (same origin).
VITE_API_BASE=
# Sign in with Apple (web JS) service id + redirect URI registered with Apple
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
# Google OAuth client ids used by the native Google sign-in plugin
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=
